{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome iPhone Duo app catalog",
  "description": "The standard schema covers structure. scripts/check.py also checks URLs, canonical app identities, evidence coverage, dates and sorting.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "url",
      "description",
      "evidence_url",
      "evidence_note",
      "tier",
      "availability",
      "checked_at",
      "features",
      "feature_evidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "evidence_note": {
        "type": "string",
        "minLength": 1
      },
      "checked_at": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "url": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      },
      "evidence_url": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      },
      "source_url": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      },
      "tier": {
        "type": "string",
        "enum": [
          "primary",
          "curated",
          "reported",
          "community"
        ]
      },
      "availability": {
        "type": "string",
        "enum": [
          "available",
          "source-build",
          "beta",
          "announced",
          "unconfirmed",
          "prototype"
        ]
      },
      "features": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "hinge-input",
            "posture-layout",
            "cover-display",
            "expanded-layout",
            "split-view",
            "support-only"
          ]
        }
      },
      "feature_evidence": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      },
      "additional_evidence_urls": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      },
      "limitation": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  }
}
