{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contributed physical-device test reports",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "app_id": {
        "type": "string",
        "minLength": 1
      },
      "tester": {
        "type": "string",
        "minLength": 1
      },
      "device": {
        "type": "string",
        "minLength": 1
      },
      "os_version": {
        "type": "string",
        "minLength": 1
      },
      "app_version": {
        "type": "string",
        "minLength": 1
      },
      "tested_at": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "result": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "passed",
          "partial",
          "failed"
        ]
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "observed": {
        "type": "string",
        "minLength": 1
      },
      "evidence_url": {
        "type": "string",
        "minLength": 1
      },
      "environment": {
        "type": "string",
        "enum": [
          "physical-device",
          "simulator"
        ]
      }
    },
    "required": [
      "id",
      "app_id",
      "tester",
      "device",
      "os_version",
      "app_version",
      "tested_at",
      "result",
      "steps",
      "observed",
      "evidence_url",
      "environment"
    ],
    "additionalProperties": false
  }
}
